{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ildrm/shield-captcha",
    "type": "project",
    "description": "Self-operated CAPTCHA and abuse controls.",
    "keywords": [
        "captcha",
        "laravel",
        "security"
    ],
    "license": "GPL-2.0-only",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": false,
        "platform": {
            "php": "8.3.0"
        },
        "platform-check": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
