APP_NAME="Shield CAPTCHA"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shield
DB_USERNAME=shield
DB_PASSWORD=
# DB_SOCKET=/path/to/mysql.sock

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=90
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Use array transport locally and configure SMTP on the deployed service.
MAIL_MAILER=array
MAIL_FROM_ADDRESS=shield@example.test
MAIL_FROM_NAME="${APP_NAME}"

# Hosted renewal. The ZarinPal flag supplies the legacy default until an administrator saves provider settings.
BILLING_ZARINPAL_ENABLED=false
BILLING_ZARINPAL_ENVIRONMENT=sandbox
BILLING_ZARINPAL_MERCHANT_ID=
BILLING_PLAN_AMOUNT_IRR=0
BILLING_PLAN_TERM_DAYS=30
BILLING_PLAN_DAILY_VERIFICATIONS=50000
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=
BILLING_STRIPE_CURRENCY=USD
BILLING_STRIPE_AMOUNT_MINOR=0

# Provision site keys in the server CLI. The Kavenegar flag supplies the legacy default until provider settings are saved.
SHIELD_SMS_KAVENEGAR_ENABLED=false
SHIELD_SMS_KAVENEGAR_TEMPLATES=
